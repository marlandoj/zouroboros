{
  "name": "zouroboros-cli",
  "version": "2.2.0",
  "description": "Unified CLI for Zouroboros",
  "type": "module",
  "engines": {
    "bun": ">=1.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "skills/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/marlandoj/zouroboros.git",
    "directory": "cli"
  },
  "bin": {
    "zouroboros": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test src"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "chalk": "^5.3.0",
    "zouroboros-core": "workspace:*",
    "zouroboros-memory": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "zouroboros-swarm": "workspace:*",
    "zouroboros-personas": "workspace:*",
    "zouroboros-selfheal": "workspace:*",
    "zouroboros-workflow": "workspace:*"
  },
  "keywords": [
    "cli",
    "zouroboros",
    "ai",
    "orchestration"
  ],
  "license": "MIT",
  "author": "Zouroboros Contributors"
}
