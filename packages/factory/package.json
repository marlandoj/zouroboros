{
  "name": "zouroboros-factory",
  "version": "0.1.0",
  "description": "Governed software-factory conveyor for Zouroboros",
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "bin": {
    "zouroboros-factory": "./scripts/factory-package-cli.ts"
  },
  "files": [
    "scripts/",
    "contracts/",
    "fixtures/",
    "game-gauntlet/",
    "scenarios/",
    "templates/",
    "software-template-library/",
    "config/factory-state-owners-v1.json",
    "MVP_PATH.md",
    "OPERATORS_MANUAL.md",
    "README.md",
    "tsconfig.json",
    "LICENSE"
  ],
  "dependencies": {
    "@zouroboros/hetzner-exec": "workspace:*",
    "ajv": "8.17.1",
    "zouroboros-core": "workspace:*",
    "zouroboros-selfheal": "workspace:*",
    "zouroboros-swarm": "workspace:*",
    "zouroboros-workflow": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "zouroboros",
    "software-factory",
    "agent-orchestration",
    "governance",
    "conveyor"
  ],
  "license": "MIT",
  "author": "marlandoj.zo.computer",
  "repository": {
    "type": "git",
    "url": "https://github.com/marlandoj/zouroboros.git",
    "directory": "packages/factory"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test scripts/factory-package-cli.test.ts scripts/runtime-materialize.test.ts",
    "test:archive": "bun test scripts/factory-package-archive.test.ts",
    "package-check": "bun scripts/factory-package-cli.ts package-check",
    "smoke": "bun scripts/factory-package-cli.ts smoke --root ../..",
    "prepack": "bun run typecheck && bun run package-check"
  }
}
