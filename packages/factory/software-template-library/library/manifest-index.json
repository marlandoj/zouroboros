{
  "schemaVersion": 1,
  "catalogVersion": "1.0.0",
  "status": "published",
  "resolutionContract": {
    "version": "1.0.0",
    "hashAlgorithm": "sha256-canonical-json",
    "hashInput": "fully resolved category, detail level, ordered annexes, assumptions, catalog version, maturity, and resolution contract version",
    "hashOutput": "resolved template manifest sha256 and discovery-index entry",
    "baseTemplateCount": 1,
    "mergeOrder": [
      "category",
      "detail-level",
      "annexes-in-declared-order",
      "user-answers"
    ],
    "arrayPolicy": "append-unique",
    "conflictPolicy": "fail-closed",
    "rules": [
      "Resolve one exact category id@version before applying a detail level.",
      "Apply annexes only in the operator-declared order; every required annex must already be present.",
      "Validate the annex requires graph with depth-first traversal; reject any back-edge as a dependency cycle before resolution.",
      "Reject duplicate, unknown, incompatible, cyclic, floating-version, or hash-drift inputs.",
      "Append unique category, level, and annex decisions, requirements, and verifications; never overwrite earlier entries silently.",
      "User answers may resolve declared decisions and supply repository facts but may not delete source-derived requirements.",
      "Any incompatible assumption or unresolved consequential decision returns HOLD or FAIL rather than a default."
    ]
  },
  "exportContract": {
    "version": "1.0.0",
    "artifactKinds": [
      "factory-ticket",
      "swarm-seed"
    ],
    "candidateOnly": true,
    "requiredValidationDecision": "PASS",
    "requiredLineage": [
      "source path",
      "source sha256",
      "build-spec version",
      "template id",
      "template version",
      "template level",
      "template sha256",
      "ordered annex ids, versions, and sha256 values"
    ],
    "ticketHeaders": [
      "Acceptance Criteria",
      "Target Repo",
      "Archetype",
      "Repro"
    ],
    "prohibitedAuthorities": [
      "create or mutate Linear",
      "apply factory-ready",
      "dispatch",
      "merge",
      "migrate data",
      "deploy",
      "publish",
      "finalize courseware"
    ],
    "failurePolicy": "Fail closed when deterministic validation, lineage, target repository, archetype, area, or live parser validation is unavailable."
  },
  "assumptionVocabulary": [
    {
      "id": "anonymous-only",
      "description": "The product intentionally has no identity, account, session, role, or resource-ownership model."
    },
    {
      "id": "offline-only",
      "description": "Every required workflow must complete without network access or a remotely hosted dependency."
    },
    {
      "id": "online-required",
      "description": "The primary workflow requires an active network connection and does not promise offline completion."
    }
  ],
  "executionModeDefinitions": {
    "direct": "One bounded builder owns implementation and integration; no parallel workstreams are implied.",
    "swarm": "Multiple dependency-aware workstreams execute under explicit ownership, integration, and approval gates.",
    "undecided": "Execution topology is a blocking human decision; the artifact remains HOLD and cannot be exported for factory execution until resolved."
  },
