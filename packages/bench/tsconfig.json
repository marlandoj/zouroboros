{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["bun-types"]
  },
  "include": ["adapters/**/*.ts", "scripts/**/*.ts", "contracts/**/*.ts", "coding/**/*.ts", "explorer/**/*.ts"],
  "exclude": ["node_modules", "dist", "data"]
}
