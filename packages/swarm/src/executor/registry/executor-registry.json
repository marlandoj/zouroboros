    {
      "id": "opencode",
      "name": "OpenCode CLI",
      "executor": "local",
      "transport": "acp",
      "description": "Vendor-neutral OpenCode ACP executor with task-scoped provider and model selection",
      "expertise": [
        "code-generation",
        "code-review",
        "debugging",
        "refactoring",
        "testing",
        "shell-commands",
        "file-editing",
        "vendor-neutral",
        "multi-provider"
      ],
      "best_for": [
        "Model-comparison tasks requiring one neutral harness",
        "Repository-aware implementation across independent providers",
        "Task-scoped provider and model pinning",
        "Cross-provider failover without changing global configuration"
      ],
      "config": {
        "defaultTimeout": 600,
        "model": "synthetic-new/hf:zai-org/GLM-5.2",
        "envVars": {
          "SWARM_OPENCODE_ENABLED": "Set to 1 to include OpenCode in automatic swarm routing",
          "SF_OPENCODE_ENABLED": "Set to 1 to include OpenCode in the Software Factory chain"
        }
      },
      "capabilities": {
        "fileRead": true,
        "fileWrite": true,
        "shellExec": true,
        "webResearch": true,
        "imageGen": false,
        "mcp": true,
        "streaming": true
      },
      "healthCheck": {
        "command": "opencode --version",
        "expectedPattern": "1.",
        "description": "Verify OpenCode CLI and native ACP command are installed"
      },
      "acp": {
        "adapterBin": "opencode",
        "adapterArgs": [
          "acp",
          "--pure"
        ],
        "modelSelection": {
          "method": "session-config",
          "configId": "model",
          "category": "model",
          "providerSeparator": "/"
        },
        "endpointClass": "opencode-provider",
        "providerTemplates": {
          "opencode": {
            "endpointClass": "opencode-zen",
            "credentialEnv": "OPENCODE_API_KEY"
          },
          "synthetic-new": {
            "endpointClass": "synthetic-direct",
            "credentialEnv": "SYNTHETIC_NEW_API_KEY",
            "launchConfig": {
              "envVar": "OPENCODE_CONFIG_CONTENT",
              "value": {
                "provider": {
                  "synthetic-new": {
                    "name": "Synthetic.new",
                    "npm": "@ai-sdk/openai-compatible",
                    "env": [
                      "SYNTHETIC_NEW_API_KEY"
                    ],
                    "options": {
                      "baseURL": "https://api.synthetic.new/openai/v1",
                      "apiKey": "{env:SYNTHETIC_NEW_API_KEY}"
                    },
                    "models": {
                      "hf:zai-org/GLM-5.2": {
                        "name": "GLM-5.2",
                        "family": "glm",
                        "tool_call": true
                      }
                    }
                  }
                }
              }
            }
          },
          "xai": {
            "endpointClass": "xai-direct",
            "credentialEnv": "XAI_API_KEY"
          },
          "openrouter": {
            "endpointClass": "openrouter-gateway",
            "credentialEnv": "OPENROUTER_API_KEY"
          },
          "deepseek": {
            "endpointClass": "deepseek-direct",
            "credentialEnv": "DEEPSEEK_API_KEY"
          }
        }
      },
      "modelRouter": {
        "defaultModel": "synthetic-new/hf:zai-org/GLM-5.2",
        "fallbackModel": "xai/grok-build-0.1",
        "passthrough": true,
        "rejectPrefixes": [
          "byok:"
        ],
        "tierMap": {
          "trivial": "openrouter/openai/gpt-oss-20b:free",
          "simple": "synthetic-new/hf:zai-org/GLM-5.2",
          "moderate": "synthetic-new/hf:zai-org/GLM-5.2",
          "complex": "xai/grok-build-0.1",
          "light": "openrouter/openai/gpt-oss-20b:free",
          "mid": "synthetic-new/hf:zai-org/GLM-5.2",
          "heavy": "xai/grok-build-0.1",
          "failover": "xai/grok-build-0.1",
          "swarm-light": "openrouter/openai/gpt-oss-20b:free",
          "swarm-mid": "synthetic-new/hf:zai-org/GLM-5.2",
          "swarm-heavy": "xai/grok-build-0.1",
          "swarm-failover": "xai/grok-build-0.1"
        }
      },
      "sdk": {
        "ragCorpus": "opencode-sdk",
        "package": "@opencode-ai/sdk",
        "version": "1.18.4",
        "runtimeVersion": "1.18.4",
        "language": "typescript",
        "sourceType": "official-sdk",
        "reference": "packages/swarm/docs/executors/identities/opencode.md",
        "surfaces": [
          "client-server",
          "sessions",
          "messages",
          "tools",
          "files",
          "events",
          "providers",
          "projects"
        ],
        "runtimeStatus": "production-runtime",
        "promotionRequired": false
      },
      "rollout": {
        "autoRoutingEnv": "SWARM_OPENCODE_ENABLED",
        "factoryRoutingEnv": "SF_OPENCODE_ENABLED"
      }
    },
