# /etc/hetzner-exec/env — environment for the hetzner-exec MCP server.
# Copy to /etc/hetzner-exec/env on the Hetzner box and fill in real values.
# Referenced by deploy/hetzner-exec.service (--env-file).

# REQUIRED — shared secret (or Zo access token) checked on every request (bearer auth).
HETZNER_EXEC_TOKEN=change-me-to-a-long-random-secret

# Listen port (must match the UFW rule from ZOU-414 cloud-init; default 6666).
HETZNER_EXEC_PORT=6666

# Sandbox provider for `sandbox=true` runs: "docker" (default) or "hcloud".
HETZNER_EXEC_SANDBOX_PROVIDER=docker

# Default docker image for sandbox/non-sandbox docker runs without an explicit image.
HETZNER_EXEC_DEFAULT_IMAGE=debian:12-slim

# Timeout defaults (ms). 0 / unset => defaultTimeoutMs. Capped at maxTimeoutMs.
HETZNER_EXEC_DEFAULT_TIMEOUT_MS=30000
HETZNER_EXEC_MAX_TIMEOUT_MS=3600000

# --- hcloud sandbox provider (only required when HETZNER_EXEC_SANDBOX_PROVIDER=hcloud) ---
# Public base URL the sandbox VMs POST their result back to (must be reachable from the VM).
HETZNER_EXEC_PUBLIC_URL=https://box.example.com
# Hetzner Cloud API token (used to create/destroy fresh sandbox VMs).
HETZNER_API_TOKEN=
# Name of the SSH key registered in Hetzner Cloud (injected into sandbox VMs).
HETZNER_SANDBOX_SSH_KEY_NAME=hetzner-annex-key
HETZNER_SANDBOX_SERVER_TYPE=cx22
HETZNER_SANDBOX_IMAGE=debian-12
HETZNER_SANDBOX_LOCATION=fsn1
